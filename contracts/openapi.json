{
  "openapi": "3.1.0",
  "info": {
    "title": "Hedger API",
    "version": "0.1.0"
  },
  "servers": [{ "url": "/api/v1" }],
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "getLiveness",
        "responses": {
          "200": {
            "description": "The process is alive",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "description": "A usable snapshot is available",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } }
          },
          "503": {
            "description": "No usable snapshot is available",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
          }
        }
      }
    },
    "/bootstrap": {
      "get": {
        "operationId": "getBootstrap",
        "responses": {
          "200": {
            "description": "Small application startup contract",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Bootstrap" } } }
          },
          "503": {
            "description": "Bootstrap data is unavailable",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
          }
        }
      }
    },
    "/transactions": {
      "get": {
        "operationId": "getTransactions",
        "description": "Returns complete transaction DTOs matching one hledger query. Empty query matches all. Relative dates are resolved against the snapshot's latest transaction date (1970-01-01 for an empty journal), and that reference is preserved by cursors.",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "schema": { "type": "string", "maxLength": 2048 },
            "description": "One URL-encoded hledger query-language expression. This value is redacted from access logs."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Opaque continuation cursor bound to query, revision, ordering, and relative-date reference."
          }
        ],
        "responses": {
          "200": {
            "description": "One page of complete matching journal transactions, newest first",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TransactionsResponse" } } }
          },
          "400": {
            "description": "Invalid query, limit, unsupported report option, or conflicting cursor",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
          },
          "503": {
            "description": "No usable journal snapshot is available",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
          }
        }
      }
    },
    "/net-worth/query": {
      "post": {
        "operationId": "queryNetWorth",
        "description": "Returns the complete Net Worth screen projection for one selected timeline and category configuration.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AnalyticsRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Headline, timeline, category, and performance projections",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NetWorthResponse" } } }
          },
          "400": {
            "description": "Invalid granularity, period, or category depth",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
          },
          "503": {
            "description": "No usable journal snapshot is available",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
          }
        }
      }
    },
    "/investments/query": {
      "post": {
        "operationId": "queryInvestments",
        "description": "Returns the investment performance projection for the configured investment mappings and an optional fully qualified asset-account subtree.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InvestmentsRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Portfolio summary, historical performance, breadcrumbs, child account summaries, and structured completeness warnings",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InvestmentsResponse" } } }
          },
          "400": {
            "description": "Invalid granularity, display commodity, or account prefix",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
          },
          "503": {
            "description": "No usable journal snapshot is available",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
          }
        }
      }
    },
    "/cashflow/query": {
      "post": {
        "operationId": "queryCashflow",
        "description": "Returns counts, timeline, and category projections using the same hledger query semantics as Transactions.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AnalyticsRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Cashflow screen projection; timelineAvailable is false rather than returning partial converted data",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CashflowResponse" } } }
          },
          "400": {
            "description": "Invalid hledger query, granularity, period, or category depth",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
          },
          "503": {
            "description": "No usable journal snapshot is available",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
          }
        }
      }
    },
    "/activity/query": {
      "post": {
        "operationId": "queryActivity",
        "description": "Returns month or fiscal-year activity buckets with complete contributing transaction DTOs.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ActivityRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Income, expense, asset, or liability activity",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ActivityResponse" } } }
          },
          "400": {
            "description": "Invalid hledger query, activity period, kind, range, or category depth",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
          },
          "503": {
            "description": "No usable journal snapshot is available",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
          }
        }
      }
    },
    "/accounts/tree": {
      "get": {
        "operationId": "getAccountsTree",
        "description": "Returns the complete hledger-derived account hierarchy with raw balances and an optional hledger market valuation. Direct balances exclude child accounts; subtree balances include descendants. The commodity query parameter defaults to the configured display commodity.",
        "parameters": [
          {
            "name": "commodity",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "minLength": 1 },
            "description": "Commodity for the hledger valuation projection. Raw balances are always returned unchanged."
          }
        ],
        "responses": {
          "200": {
            "description": "The complete account hierarchy",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountsTreeResponse" } } }
          },
          "503": {
            "description": "No usable journal snapshot is available",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "required": ["status"],
        "properties": { "status": { "type": "string", "enum": ["ok"] } },
        "additionalProperties": false
      },
      "Bootstrap": {
        "type": "object",
        "required": ["apiVersion", "appName", "fiscalYearStartMonth", "defaultValuationBasis", "metadata"],
        "properties": {
          "apiVersion": { "const": "v1" },
          "appName": { "const": "Hedger" },
          "fiscalYearStartMonth": { "type": "integer", "minimum": 1, "maximum": 12 },
          "defaultValuationBasis": { "type": "string", "enum": ["period-end"] },
          "metadata": { "$ref": "#/components/schemas/ResponseMetadata" }
        },
        "additionalProperties": false
      },
      "ResponseMetadata": {
        "type": "object",
        "required": ["revision", "freshness", "warnings"],
        "properties": {
          "revision": { "type": "string", "minLength": 1 },
          "freshness": { "type": "string", "enum": ["fresh", "stale", "refreshing", "partial", "unavailable"] },
          "warnings": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      },
      "Tag": {
        "type": "object",
        "required": ["name", "value"],
        "properties": {
          "name": { "type": "string" },
          "value": { "type": "string" }
        },
        "additionalProperties": false
      },
      "Cost": {
        "type": "object",
        "required": ["costType", "commodity", "quantity"],
        "properties": {
          "costType": { "type": "string", "enum": ["unit", "total"] },
          "commodity": { "type": "string" },
          "quantity": { "type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$" }
        },
        "additionalProperties": false
      },
      "Amount": {
        "type": "object",
        "required": ["commodity", "quantity", "cost"],
        "properties": {
          "commodity": { "type": "string" },
          "quantity": { "type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$" },
          "cost": {
            "anyOf": [
              { "$ref": "#/components/schemas/Cost" },
              { "type": "null" }
            ]
          }
        },
        "additionalProperties": false
      },
      "Posting": {
        "type": "object",
        "required": ["account", "status", "comment", "tags", "amounts"],
        "properties": {
          "account": { "type": "string" },
          "status": { "type": "string", "enum": ["unmarked", "pending", "cleared"] },
          "comment": { "type": ["string", "null"] },
          "tags": { "type": "array", "items": { "$ref": "#/components/schemas/Tag" } },
          "amounts": { "type": "array", "items": { "$ref": "#/components/schemas/Amount" } }
        },
        "additionalProperties": false
      },
      "CommodityQuantity": {
        "type": "object",
        "required": ["commodity", "quantity"],
        "properties": {
          "commodity": { "type": "string" },
          "quantity": { "type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$" }
        },
        "additionalProperties": false
      },
      "TransactionPresentation": {
        "type": "object",
        "required": ["classification", "fromAccounts", "toAccounts", "totalAmounts", "openingAccountCount"],
        "properties": {
          "classification": { "type": "string", "enum": ["income", "expense", "transfer", "opening_balance"] },
          "fromAccounts": { "type": "array", "items": { "type": "string" } },
          "toAccounts": { "type": "array", "items": { "type": "string" } },
          "totalAmounts": { "type": "array", "items": { "$ref": "#/components/schemas/CommodityQuantity" } },
          "openingAccountCount": { "type": ["integer", "null"], "minimum": 1 }
        },
        "additionalProperties": false
      },
      "Transaction": {
        "type": "object",
        "required": ["primaryDate", "secondaryDate", "status", "code", "description", "comment", "tags", "postings", "presentation"],
        "properties": {
          "primaryDate": { "type": "string", "format": "date" },
          "secondaryDate": { "type": ["string", "null"], "format": "date" },
          "status": { "type": "string", "enum": ["unmarked", "pending", "cleared"] },
          "code": { "type": ["string", "null"] },
          "description": { "type": "string" },
          "comment": { "type": ["string", "null"] },
          "tags": { "type": "array", "items": { "$ref": "#/components/schemas/Tag" } },
          "postings": { "type": "array", "items": { "$ref": "#/components/schemas/Posting" } },
          "presentation": { "$ref": "#/components/schemas/TransactionPresentation" }
        },
        "additionalProperties": false
      },
      "TransactionsResponse": {
        "type": "object",
        "required": ["metadata", "transactions", "nextCursor"],
        "properties": {
          "metadata": { "$ref": "#/components/schemas/ResponseMetadata" },
          "transactions": { "type": "array", "items": { "$ref": "#/components/schemas/Transaction" } },
          "nextCursor": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      },
      "AnalyticsRequest": {
        "type": "object",
        "required": ["granularity"],
        "properties": {
          "query": { "type": ["string", "null"], "maxLength": 2048 },
          "granularity": { "type": "string", "enum": ["monthly", "yearly"] },
          "displayCommodity": { "type": ["string", "null"] },
          "positivePeriod": { "type": ["string", "null"] },
          "negativePeriod": { "type": ["string", "null"] },
          "positiveDepth": { "type": ["integer", "null"], "minimum": 1, "maximum": 4, "default": 2 },
          "negativeDepth": { "type": ["integer", "null"], "minimum": 1, "maximum": 4, "default": 2 }
        },
        "additionalProperties": false
      },
      "ActivityRequest": {
        "type": "object",
        "required": ["kind", "range", "period"],
        "properties": {
          "kind": { "type": "string", "enum": ["income", "expense", "asset", "liability"] },
          "range": { "type": "string", "enum": ["month", "year"] },
          "period": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
          "query": { "type": ["string", "null"], "maxLength": 2048 },
          "displayCommodity": { "type": ["string", "null"] },
          "depth": { "type": ["integer", "null"], "minimum": 1, "maximum": 4, "default": 2 }
        },
        "additionalProperties": false
      },
      "Kpi": {
        "type": "object",
        "required": ["value", "absoluteChange", "percentageChange", "trend"],
        "properties": {
          "value": { "$ref": "#/components/schemas/Decimal" },
          "absoluteChange": { "anyOf": [{ "$ref": "#/components/schemas/Decimal" }, { "type": "null" }] },
          "percentageChange": { "anyOf": [{ "$ref": "#/components/schemas/Decimal" }, { "type": "null" }] },
          "trend": { "type": "array", "items": { "$ref": "#/components/schemas/Decimal" } }
        },
        "additionalProperties": false
      },
      "TimelinePoint": {
        "type": "object",
        "required": ["period", "startDate", "positive", "negative", "net"],
        "properties": {
          "period": { "type": "string" },
          "startDate": { "type": "string", "format": "date" },
          "positive": { "$ref": "#/components/schemas/Decimal" },
          "negative": { "$ref": "#/components/schemas/Decimal" },
          "net": { "$ref": "#/components/schemas/Decimal" }
        },
        "additionalProperties": false
      },
      "BreakdownItem": {
        "type": "object",
        "required": ["account", "quantity"],
        "properties": {
          "account": { "type": "string" },
          "quantity": { "$ref": "#/components/schemas/Decimal" }
        },
        "additionalProperties": false
      },
      "CategoryBreakdown": {
        "type": "object",
        "required": ["period", "total", "items", "otherItems"],
        "properties": {
          "period": { "type": "string" },
          "total": { "$ref": "#/components/schemas/Decimal" },
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/BreakdownItem" } },
          "otherItems": { "type": "array", "items": { "$ref": "#/components/schemas/BreakdownItem" } }
        },
        "additionalProperties": false
      },
      "PerformancePoint": {
        "type": "object",
        "required": ["period", "startDate", "netInvestment", "netWorth", "gainLoss"],
        "properties": {
          "period": { "type": "string" },
          "startDate": { "type": "string", "format": "date" },
          "netInvestment": { "$ref": "#/components/schemas/Decimal" },
          "netWorth": { "$ref": "#/components/schemas/Decimal" },
          "gainLoss": { "$ref": "#/components/schemas/Decimal" }
        },
        "additionalProperties": false
      },
      "NetWorthResponse": {
        "type": "object",
        "required": ["metadata", "displayCommodity", "granularity", "netWorth", "assets", "liabilities", "timeline", "assetsBreakdown", "liabilitiesBreakdown", "performance", "incompletePeriods", "warnings"],
        "properties": {
          "metadata": { "$ref": "#/components/schemas/ResponseMetadata" },
          "displayCommodity": { "type": "string" },
          "granularity": { "type": "string", "enum": ["monthly", "yearly"] },
          "netWorth": { "$ref": "#/components/schemas/Kpi" },
          "assets": { "$ref": "#/components/schemas/Kpi" },
          "liabilities": { "$ref": "#/components/schemas/Kpi" },
          "timeline": { "type": "array", "items": { "$ref": "#/components/schemas/TimelinePoint" } },
          "assetsBreakdown": { "$ref": "#/components/schemas/CategoryBreakdown" },
          "liabilitiesBreakdown": { "$ref": "#/components/schemas/CategoryBreakdown" },
          "performance": { "type": "array", "items": { "$ref": "#/components/schemas/PerformancePoint" } },
          "incompletePeriods": { "type": "integer", "minimum": 0 },
          "warnings": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      },
      "InvestmentsRequest": {
        "type": "object",
        "required": ["granularity"],
        "properties": {
          "granularity": { "type": "string", "enum": ["monthly", "yearly"] },
          "displayCommodity": { "type": ["string", "null"] },
          "accountPrefix": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      },
      "InvestmentSummary": {
        "type": "object",
        "required": ["marketValue", "purchaseCost", "gainLoss", "returnPercentage", "attributedIncome", "realisedGain", "totalProfit", "completeness"],
        "properties": {
          "marketValue": { "anyOf": [{ "$ref": "#/components/schemas/Decimal" }, { "type": "null" }] },
          "purchaseCost": { "anyOf": [{ "$ref": "#/components/schemas/Decimal" }, { "type": "null" }] },
          "gainLoss": { "anyOf": [{ "$ref": "#/components/schemas/Decimal" }, { "type": "null" }] },
          "returnPercentage": { "anyOf": [{ "$ref": "#/components/schemas/Decimal" }, { "type": "null" }] },
          "attributedIncome": { "anyOf": [{ "$ref": "#/components/schemas/Decimal" }, { "type": "null" }] },
          "realisedGain": { "anyOf": [{ "$ref": "#/components/schemas/Decimal" }, { "type": "null" }] },
          "totalProfit": { "anyOf": [{ "$ref": "#/components/schemas/Decimal" }, { "type": "null" }] },
          "completeness": { "type": "string", "enum": ["complete", "partial", "unavailable"] }
        },
        "additionalProperties": false
      },
      "InvestmentTimelinePoint": {
        "type": "object",
        "required": ["period", "startDate", "marketValue", "purchaseCost", "gainLoss", "returnPercentage", "attributedIncome", "realisedGain", "totalProfit", "completeness"],
        "properties": {
          "period": { "type": "string" },
          "startDate": { "type": "string", "format": "date" },
          "marketValue": { "anyOf": [{ "$ref": "#/components/schemas/Decimal" }, { "type": "null" }] },
          "purchaseCost": { "anyOf": [{ "$ref": "#/components/schemas/Decimal" }, { "type": "null" }] },
          "gainLoss": { "anyOf": [{ "$ref": "#/components/schemas/Decimal" }, { "type": "null" }] },
          "returnPercentage": { "anyOf": [{ "$ref": "#/components/schemas/Decimal" }, { "type": "null" }] },
          "attributedIncome": { "anyOf": [{ "$ref": "#/components/schemas/Decimal" }, { "type": "null" }] },
          "realisedGain": { "anyOf": [{ "$ref": "#/components/schemas/Decimal" }, { "type": "null" }] },
          "totalProfit": { "anyOf": [{ "$ref": "#/components/schemas/Decimal" }, { "type": "null" }] },
          "completeness": { "type": "string", "enum": ["complete", "partial", "unavailable"] }
        },
        "additionalProperties": false
      },
      "InvestmentBreadcrumb": {
        "type": "object",
        "required": ["account", "label"],
        "properties": {
          "account": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      },
      "InvestmentChild": {
        "type": "object",
        "required": ["account", "label", "summary", "hasChildren"],
        "properties": {
          "account": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "summary": { "$ref": "#/components/schemas/InvestmentSummary" },
          "hasChildren": { "type": "boolean" }
        },
        "additionalProperties": false
      },
      "InvestmentWarning": {
        "type": "object",
        "required": ["kind", "account", "message"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "account": { "type": ["string", "null"] },
          "message": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      },
      "InvestmentsResponse": {
        "type": "object",
        "required": ["metadata", "displayCommodity", "granularity", "accountPrefix", "summary", "timeline", "breadcrumbs", "children", "warnings"],
        "properties": {
          "metadata": { "$ref": "#/components/schemas/ResponseMetadata" },
          "displayCommodity": { "type": "string", "minLength": 1 },
          "granularity": { "type": "string", "enum": ["monthly", "yearly"] },
          "accountPrefix": { "type": ["string", "null"] },
          "summary": { "$ref": "#/components/schemas/InvestmentSummary" },
          "timeline": { "type": "array", "items": { "$ref": "#/components/schemas/InvestmentTimelinePoint" } },
          "breadcrumbs": { "type": "array", "items": { "$ref": "#/components/schemas/InvestmentBreadcrumb" } },
          "children": { "type": "array", "items": { "$ref": "#/components/schemas/InvestmentChild" } },
          "warnings": { "type": "array", "items": { "$ref": "#/components/schemas/InvestmentWarning" } }
        },
        "additionalProperties": false
      },
      "CashflowResponse": {
        "type": "object",
        "required": ["metadata", "displayCommodity", "granularity", "totalCount", "filteredCount", "timelineAvailable", "timeline", "incomeBreakdown", "expenseBreakdown", "warnings"],
        "properties": {
          "metadata": { "$ref": "#/components/schemas/ResponseMetadata" },
          "displayCommodity": { "type": "string" },
          "granularity": { "type": "string", "enum": ["monthly", "yearly"] },
          "totalCount": { "type": "integer", "minimum": 0 },
          "filteredCount": { "type": "integer", "minimum": 0 },
          "timelineAvailable": { "type": "boolean" },
          "timeline": { "type": "array", "items": { "$ref": "#/components/schemas/TimelinePoint" } },
          "incomeBreakdown": { "$ref": "#/components/schemas/CategoryBreakdown" },
          "expenseBreakdown": { "$ref": "#/components/schemas/CategoryBreakdown" },
          "warnings": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      },
      "ActivityBucket": {
        "type": "object",
        "required": ["key", "startDate", "total", "increase", "decrease", "reallocated", "categories", "transactions"],
        "properties": {
          "key": { "type": "string" },
          "startDate": { "type": "string", "format": "date" },
          "total": { "$ref": "#/components/schemas/Decimal" },
          "increase": { "$ref": "#/components/schemas/Decimal" },
          "decrease": { "$ref": "#/components/schemas/Decimal" },
          "reallocated": { "$ref": "#/components/schemas/Decimal" },
          "categories": { "type": "array", "items": { "$ref": "#/components/schemas/BreakdownItem" } },
          "transactions": { "type": "array", "items": { "$ref": "#/components/schemas/Transaction" } }
        },
        "additionalProperties": false
      },
      "ActivityResponse": {
        "type": "object",
        "required": ["metadata", "displayCommodity", "kind", "range", "period", "fiscalYearStartMonth", "buckets", "warnings"],
        "properties": {
          "metadata": { "$ref": "#/components/schemas/ResponseMetadata" },
          "displayCommodity": { "type": "string" },
          "kind": { "type": "string", "enum": ["income", "expense", "asset", "liability"] },
          "range": { "type": "string", "enum": ["month", "year"] },
          "period": { "type": "string" },
          "fiscalYearStartMonth": { "type": "integer", "minimum": 1, "maximum": 12 },
          "buckets": { "type": "array", "items": { "$ref": "#/components/schemas/ActivityBucket" } },
          "warnings": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      },
      "Decimal": {
        "type": "string",
        "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
      },
      "AccountNode": {
        "type": "object",
        "required": ["path", "name", "accountType", "hasChildren", "directBalances", "subtreeBalances", "valuation", "children"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "accountType": { "type": ["string", "null"] },
          "hasChildren": { "type": "boolean" },
          "directBalances": { "type": "array", "items": { "$ref": "#/components/schemas/CommodityQuantity" } },
          "subtreeBalances": { "type": "array", "items": { "$ref": "#/components/schemas/CommodityQuantity" } },
          "valuation": { "$ref": "#/components/schemas/AccountValuation" },
          "children": { "type": "array", "items": { "$ref": "#/components/schemas/AccountNode" } }
        },
        "additionalProperties": false
      },
      "AccountValuation": {
        "type": "object",
        "required": ["asOf", "commodity", "directBalances", "subtreeBalances", "completeness"],
        "properties": {
          "asOf": { "type": "string", "format": "date" },
          "commodity": { "type": "string", "minLength": 1 },
          "directBalances": { "type": "array", "items": { "$ref": "#/components/schemas/CommodityQuantity" } },
          "subtreeBalances": { "type": "array", "items": { "$ref": "#/components/schemas/CommodityQuantity" } },
          "completeness": { "type": "string", "enum": ["complete", "partial", "unavailable"] }
        },
        "additionalProperties": false
      },
      "AccountsTreeResponse": {
        "type": "object",
        "required": ["metadata", "displayCommodity", "accounts"],
        "properties": {
          "metadata": { "$ref": "#/components/schemas/ResponseMetadata" },
          "displayCommodity": { "type": "string", "minLength": 1 },
          "accounts": { "type": "array", "items": { "$ref": "#/components/schemas/AccountNode" } }
        },
        "additionalProperties": false
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "requestId"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "requestId": { "type": "string" },
              "details": {
                "type": "object",
                "required": ["reason", "position"],
                "properties": {
                  "reason": { "type": "string" },
                  "position": { "type": ["integer", "null"], "minimum": 1 }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  }
}
