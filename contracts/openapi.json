{
  "openapi": "3.1.0",
  "info": {
    "title": "Hedger API",
    "version": "0.1.0"
  },
  "servers": [{ "url": "/api/v1" }],
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "getLiveness",
        "responses": {
          "200": {
            "description": "The process is alive",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "description": "A usable snapshot is available",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } }
          },
          "503": {
            "description": "No usable snapshot is available",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
          }
        }
      }
    },
    "/bootstrap": {
      "get": {
        "operationId": "getBootstrap",
        "responses": {
          "200": {
            "description": "Small application startup contract",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Bootstrap" } } }
          },
          "503": {
            "description": "Bootstrap data is unavailable",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
          }
        }
      }
    },
    "/transactions": {
      "get": {
        "operationId": "getTransactions",
        "responses": {
          "200": {
            "description": "Every complete journal transaction, newest first",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TransactionsResponse" } } }
          },
          "503": {
            "description": "No usable journal snapshot is available",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "required": ["status"],
        "properties": { "status": { "type": "string", "enum": ["ok"] } },
        "additionalProperties": false
      },
      "Bootstrap": {
        "type": "object",
        "required": ["apiVersion", "appName", "fiscalYearStartMonth", "defaultValuationBasis", "metadata"],
        "properties": {
          "apiVersion": { "const": "v1" },
          "appName": { "const": "Hedger" },
          "fiscalYearStartMonth": { "type": "integer", "minimum": 1, "maximum": 12 },
          "defaultValuationBasis": { "type": "string", "enum": ["period-end"] },
          "metadata": { "$ref": "#/components/schemas/ResponseMetadata" }
        },
        "additionalProperties": false
      },
      "ResponseMetadata": {
        "type": "object",
        "required": ["revision", "freshness", "warnings"],
        "properties": {
          "revision": { "type": "string", "minLength": 1 },
          "freshness": { "type": "string", "enum": ["fresh", "stale", "refreshing", "partial", "unavailable"] },
          "warnings": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      },
      "Tag": {
        "type": "object",
        "required": ["name", "value"],
        "properties": {
          "name": { "type": "string" },
          "value": { "type": "string" }
        },
        "additionalProperties": false
      },
      "Cost": {
        "type": "object",
        "required": ["costType", "commodity", "quantity"],
        "properties": {
          "costType": { "type": "string", "enum": ["unit", "total"] },
          "commodity": { "type": "string" },
          "quantity": { "type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$" }
        },
        "additionalProperties": false
      },
      "Amount": {
        "type": "object",
        "required": ["commodity", "quantity", "cost"],
        "properties": {
          "commodity": { "type": "string" },
          "quantity": { "type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$" },
          "cost": {
            "anyOf": [
              { "$ref": "#/components/schemas/Cost" },
              { "type": "null" }
            ]
          }
        },
        "additionalProperties": false
      },
      "Posting": {
        "type": "object",
        "required": ["account", "status", "comment", "tags", "amounts"],
        "properties": {
          "account": { "type": "string" },
          "status": { "type": "string", "enum": ["unmarked", "pending", "cleared"] },
          "comment": { "type": ["string", "null"] },
          "tags": { "type": "array", "items": { "$ref": "#/components/schemas/Tag" } },
          "amounts": { "type": "array", "items": { "$ref": "#/components/schemas/Amount" } }
        },
        "additionalProperties": false
      },
      "CommodityQuantity": {
        "type": "object",
        "required": ["commodity", "quantity"],
        "properties": {
          "commodity": { "type": "string" },
          "quantity": { "type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$" }
        },
        "additionalProperties": false
      },
      "TransactionPresentation": {
        "type": "object",
        "required": ["classification", "fromAccounts", "toAccounts", "totalAmounts", "openingAccountCount"],
        "properties": {
          "classification": { "type": "string", "enum": ["income", "expense", "transfer", "opening_balance"] },
          "fromAccounts": { "type": "array", "items": { "type": "string" } },
          "toAccounts": { "type": "array", "items": { "type": "string" } },
          "totalAmounts": { "type": "array", "items": { "$ref": "#/components/schemas/CommodityQuantity" } },
          "openingAccountCount": { "type": ["integer", "null"], "minimum": 1 }
        },
        "additionalProperties": false
      },
      "Transaction": {
        "type": "object",
        "required": ["primaryDate", "secondaryDate", "status", "code", "description", "comment", "tags", "postings", "presentation"],
        "properties": {
          "primaryDate": { "type": "string", "format": "date" },
          "secondaryDate": { "type": ["string", "null"], "format": "date" },
          "status": { "type": "string", "enum": ["unmarked", "pending", "cleared"] },
          "code": { "type": ["string", "null"] },
          "description": { "type": "string" },
          "comment": { "type": ["string", "null"] },
          "tags": { "type": "array", "items": { "$ref": "#/components/schemas/Tag" } },
          "postings": { "type": "array", "items": { "$ref": "#/components/schemas/Posting" } },
          "presentation": { "$ref": "#/components/schemas/TransactionPresentation" }
        },
        "additionalProperties": false
      },
      "TransactionsResponse": {
        "type": "object",
        "required": ["metadata", "transactions"],
        "properties": {
          "metadata": { "$ref": "#/components/schemas/ResponseMetadata" },
          "transactions": { "type": "array", "items": { "$ref": "#/components/schemas/Transaction" } }
        },
        "additionalProperties": false
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "requestId"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "requestId": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  }
}
