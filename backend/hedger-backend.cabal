cabal-version:      3.0
name:               hedger-backend
version:            0.1.0.0
synopsis:           Read-only hledger backend for Hedger
description:        Backend application for the Hedger read-only ledger UI.
category:           Finance
maintainer:         Hedger contributors
license:            AGPL-3.0-or-later
build-type:         Simple

common language-settings
  default-language:    GHC2024
  default-extensions:
      DataKinds
      ImportQualifiedPost
      MultiWayIf
      OverloadedRecordDot
      OverloadedStrings
      RecordWildCards
      TemplateHaskell
      TypeOperators
  ghc-options:         -Wall -Wcompat

library
  import:               language-settings
  exposed-modules:
      Hedger.Api
      Hedger.Application
      Hedger.Config
      Hedger.Domain.Error
      Hedger.Domain.Types
      Hedger.Runtime.RequestContext
      Hedger.Runtime.Server
  hs-source-dirs:      src
  build-depends:
      aeson >=2.2 && <2.3
    , base >=4.18 && <5
    , bytestring >=0.11 && <0.13
    , http-types >=0.12 && <0.13
    , mtl >=2.3 && <2.4
    , optparse-applicative >=0.18 && <0.20
    , servant >=0.20 && <0.21
    , servant-server >=0.20 && <0.21
    , text >=2.0 && <2.2
    , transformers >=0.6 && <0.7
    , unix >=2.8 && <2.9
    , wai >=3.2 && <3.3
    , wai-extra >=3.1 && <3.2
    , warp >=3.3 && <3.5

executable hedger-server
  import:               language-settings
  main-is:             Main.hs
  hs-source-dirs:      app
  build-depends:
      base >=4.18 && <5
    , hedger-backend
    , text >=2.0 && <2.2
  ghc-options:         -threaded -rtsopts -with-rtsopts=-N

test-suite hedger-backend-test
  import:               language-settings
  type:                exitcode-stdio-1.0
  main-is:             Main.hs
  hs-source-dirs:      test
  build-depends:
      aeson >=2.2 && <2.3
    , base >=4.18 && <5
    , bytestring >=0.11 && <0.13
    , hedger-backend
    , hspec >=2.11 && <2.12
    , http-types >=0.12 && <0.13
    , text >=2.0 && <2.2
    , wai >=3.2 && <3.3
    , wai-extra >=3.1 && <3.2
