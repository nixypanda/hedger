cabal-version:      3.0
name:               hedger-backend
version:            0.1.0.0
synopsis:           Read-only hledger backend for Hedger
description:        Backend application for the Hedger read-only ledger UI.
category:           Finance
maintainer:         Hedger contributors
license:            AGPL-3.0-or-later
build-type:         Simple

common language-settings
  default-language:    GHC2024
  default-extensions:
      DataKinds
      DuplicateRecordFields
      ImportQualifiedPost
      MultiWayIf
      OverloadedRecordDot
      OverloadedStrings
      RecordWildCards
      TemplateHaskell
      TypeOperators
  ghc-options:         -Wall -Wcompat

library
  import:               language-settings
  exposed-modules:
      Hedger.Application
      Hedger.Config
      Hedger.Domain.Error
      Hedger.Domain.Snapshot
      Hedger.Domain.Transaction
      Hedger.Infrastructure.Hledger.SnapshotStore
      Hedger.Infrastructure.Hledger.TransactionQuery
      Hedger.Interface.HTTP.API
      Hedger.Interface.HTTP.Errors
      Hedger.Interface.HTTP.Middleware
      Hedger.Interface.HTTP.TransactionMapper
      Hedger.Interface.HTTP.Types
      Hedger.Runtime.Server
  hs-source-dirs:      src
  build-depends:
      aeson >=2.2 && <2.3
    , base >=4.18 && <5
    , bytestring >=0.11 && <0.13
    , containers >=0.7 && <0.8
    , cryptohash-md5 >=0.11 && <0.12
    , directory >=1.3 && <1.4
    , hledger-lib >=1.52 && <1.53
    , http-types >=0.12 && <0.13
    , mtl >=2.3 && <2.4
    , optparse-applicative >=0.18 && <0.20
    , servant >=0.20 && <0.21
    , servant-server >=0.20 && <0.21
    , text >=2.0 && <2.2
    , time >=1.12 && <1.15
    , transformers >=0.6 && <0.7
    , unix >=2.8 && <2.9
    , wai >=3.2 && <3.3
    , wai-extra >=3.1 && <3.2
    , warp >=3.3 && <3.5

executable hedger-server
  import:               language-settings
  main-is:             Main.hs
  hs-source-dirs:      app
  build-depends:
      base >=4.18 && <5
    , hedger-backend
    , text >=2.0 && <2.2
  ghc-options:         -threaded -rtsopts -with-rtsopts=-N

test-suite hedger-backend-test
  import:               language-settings
  type:                exitcode-stdio-1.0
  main-is:             Main.hs
  hs-source-dirs:      test
  other-modules:
      Hedger.TestHelpers
    , Hedger.SyntheticTransactions
    , Hedger.Generators
    , Hedger.ConfigSpec
    , Hedger.Domain.TransactionSpec
    , Hedger.Infrastructure.Hledger.SnapshotStoreSpec
    , Hedger.Infrastructure.Hledger.TransactionQuerySpec
    , Hedger.Interface.HTTP.APISpec
    , Hedger.Interface.HTTP.TransactionMapperSpec
  build-depends:
      aeson >=2.2 && <2.3
    , base >=4.18 && <5
    , bytestring >=0.11 && <0.13
    , hedger-backend
    , hledger-lib >=1.52 && <1.53
    , hedgehog >=1.4 && <1.6
    , tasty >=1.4 && <1.6
    , tasty-hedgehog >=1.4 && <1.5
    , tasty-hunit >=0.10 && <0.11
    , http-types >=0.12 && <0.13
    , text >=2.0 && <2.2
    , time >=1.12 && <1.15
    , wai >=3.2 && <3.3
    , wai-extra >=3.1 && <3.2

benchmark snapshot-bench
  import:               language-settings
  type:                 exitcode-stdio-1.0
  main-is:              Main.hs
  hs-source-dirs:       benchmark
  build-depends:
      aeson >=2.2 && <2.3
    , base >=4.18 && <5
    , bytestring >=0.11 && <0.13
    , deepseq >=1.4 && <1.6
    , hedger-backend
    , hledger-lib >=1.52 && <1.53
    , tasty-bench >=0.4 && <0.5
    , text >=2.0 && <2.2
