cabal-version: 3.0
name: hedger-backend
version: 0.1.0.0
synopsis: Read-only hledger backend for Hedger
description: Backend application for the Hedger read-only ledger UI.
category: Finance
maintainer: Hedger contributors
license: AGPL-3.0-or-later
build-type: Simple

common language-settings
  default-language: GHC2024
  default-extensions:
    DataKinds
    DeriveAnyClass
    DuplicateRecordFields
    ImportQualifiedPost
    MultiWayIf
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings
    RecordWildCards
    TypeOperators

  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wmissing-export-lists
    -Wmissing-deriving-strategies
    -Wpartial-fields
    -Wredundant-constraints

library
  import: language-settings
  exposed-modules:
    Hedger.Application.AccountRegisterQuery
    Hedger.Application.Analytics
    Hedger.Application.Accounts
    Hedger.Application.AppM
    Hedger.Application.Common
    Hedger.Application.Internal.Cursor
    Hedger.Application.Investments
    Hedger.Application.System
    Hedger.Application.TransactionQuery
    Hedger.Application.Transactions
    Hedger.Config
    Hedger.Domain.Account
    Hedger.Domain.Activity
    Hedger.Domain.Cashflow
    Hedger.Domain.Error
    Hedger.Domain.Internal.Account
    Hedger.Domain.Internal.InvestmentPerformance
    Hedger.Domain.Internal.PeriodReport
    Hedger.Domain.Internal.Xirr
    Hedger.Domain.Internal.Transaction
    Hedger.Domain.Investment
    Hedger.Domain.InvestmentPerformance
    Hedger.Domain.NetWorth
    Hedger.Domain.Period
    Hedger.Domain.Snapshot
    Hedger.Domain.Transaction
    Hedger.Domain.Valuation
    Hedger.Domain.Xirr
    Hedger.Infrastructure.SnapshotStore
    Hedger.Interface.HTTP.API
    Hedger.Interface.HTTP.Accounts
    Hedger.Interface.HTTP.Analytics
    Hedger.Interface.HTTP.Common
    Hedger.Interface.HTTP.Errors
    Hedger.Interface.HTTP.Investments
    Hedger.Interface.HTTP.Middleware
    Hedger.Interface.HTTP.System
    Hedger.Interface.HTTP.Transactions
    Hedger.Runtime.Server

  hs-source-dirs: src
  build-depends:
    aeson >=2.2 && <2.3,
    base >=4.18 && <5,
    bytestring >=0.11 && <0.13,
    containers >=0.7 && <0.8,
    Decimal >=0.5 && <0.6,
    cryptohash-md5 >=0.11 && <0.12,
    directory >=1.3 && <1.4,
    hledger-lib >=1.52 && <1.53,
    http-types >=0.12 && <0.13,
    mtl >=2.3 && <2.4,
    math-functions >=0.3 && <0.4,
    optparse-applicative >=0.18 && <0.20,
    servant >=0.20 && <0.21,
    servant-server >=0.20 && <0.21,
    scientific >=0.3 && <0.4,
    text >=2.0 && <2.2,
    time >=1.12 && <1.15,
    transformers >=0.6 && <0.7,
    unix >=2.8 && <2.9,
    wai >=3.2 && <3.3,
    wai-extra >=3.1 && <3.2,
    warp >=3.3 && <3.5,
    yaml >=0.11 && <0.12,

executable hedger-server
  import: language-settings
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
    base >=4.18 && <5,
    hedger-backend,
    text >=2.0 && <2.2,

  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

test-suite hedger-backend-test
  import: language-settings
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  other-modules:
    Hedger.Application.TransactionQuerySpec
    Hedger.Domain.AccountSpec
    Hedger.Domain.ActivitySpec
    Hedger.Domain.InvestmentPerformanceSpec
    Hedger.Domain.InvestmentSpec
    Hedger.ConfigSpec
    Hedger.Domain.PeriodSpec
    Hedger.Domain.TransactionSpec
    Hedger.Domain.ValuationSpec
    Hedger.Domain.XirrSpec
    Hedger.Generators
    Hedger.Infrastructure.Internal.CursorSpec
    Hedger.Infrastructure.SnapshotStoreSpec
    Hedger.Interface.HTTP.APISpec
    Hedger.Interface.HTTP.CommonSpec
    Hedger.SyntheticTransactions
    Hedger.TestHelpers

  build-depends:
    aeson >=2.2 && <2.3,
    base >=4.18 && <5,
    bytestring >=0.11 && <0.13,
    containers >=0.7 && <0.8,
    Decimal >=0.5 && <0.6,
    hedgehog >=1.4 && <1.6,
    hedger-backend,
    hledger-lib >=1.52 && <1.53,
    math-functions >=0.3 && <0.4,
    http-types >=0.12 && <0.13,
    tasty >=1.4 && <1.6,
    tasty-hedgehog >=1.4 && <1.5,
    tasty-hunit >=0.10 && <0.11,
    text >=2.0 && <2.2,
    time >=1.12 && <1.15,
    vector >=0.13 && <0.14,
    wai >=3.2 && <3.3,
    wai-extra >=3.1 && <3.2,

benchmark snapshot-bench
  import: language-settings
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: benchmark
  build-depends:
    aeson >=2.2 && <2.3,
    base >=4.18 && <5,
    bytestring >=0.11 && <0.13,
    deepseq >=1.4 && <1.6,
    hedger-backend,
    hledger-lib >=1.52 && <1.53,
    tasty-bench >=0.4 && <0.5,
    text >=2.0 && <2.2,
    time >=1.12 && <1.15,
